# Browser-facing API base (same origin via Next rewrite)
NEXT_PUBLIC_API_URL=/api

# Where Next proxies /api → Express (server-side only)
# Prefer localhost over 127.0.0.1 on Windows if IDE port-forwards are active.
# Local (no SSL): http://localhost:5013
# Prod Node HTTPS: https://127.0.0.1:PORT (must match backend PORT)
BACKEND_INTERNAL_URL=http://localhost:5013
