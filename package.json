{
  "name": "ops-ai",
  "version": "1.0.0",
  "private": true,
  "description": "OpsAi monorepo — frontend (Next.js) + backend (Express)",
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "dev:web": "npm run dev --prefix frontend",
    "dev:api": "npm run dev --prefix backend",
    "build:web": "npm run build --prefix frontend",
    "start:web": "npm run start --prefix frontend",
    "start:api": "npm start --prefix backend"
  }
}
