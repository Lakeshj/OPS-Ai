    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "cron-parser": "^5.10.0",
        "dotenv": "^16.5.0",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "jszip": "^3.10.1",
        "luxon": "^3.7.2",
        "mammoth": "^1.12.0",
        "multer": "^2.2.0",
        "mysql2": "^3.6.5",
        "node-cron": "^3.0.3",
        "nodemailer": "^9.0.3",
        "openai": "^5.0.1",
        "pdf-parse": "^1.1.4",
        "uuid": "^11.1.1"
