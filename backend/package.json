{
    "name": "opsai-backend",
    "version": "1.0.0",
    "description": "OpsAi Express API server",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "db:migrate": "node scripts/migrate.js",
        "db:export-schema": "node scripts/export-schema-sql.js",
        "worker:workflows": "node scripts/workflow-worker.js",
