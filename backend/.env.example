NODE_ENV=development
PORT=5013

# Production: set both paths → backend starts HTTPS (live).
# Local: leave unset/commented → backend starts HTTP (no SSL required).
# SSL_KEY_PATH=/var/www/opsai.socialchamps.com/ssl/socialchamps_com.key
# SSL_CERT_PATH=/var/www/opsai.socialchamps.com/ssl/socialchamps_com.crt

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=opsai

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=12h

# Encrypts workflow credentials at rest. Required in production; changing it
# makes existing stored credentials unreadable.
WORKFLOW_CREDENTIALS_KEY=generate_32_plus_random_chars

OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# Workflow Copilot (Part 14B.2) — product-level planner (not workflow node credentials)
# COPILOT_PROVIDER=openai
# COPILOT_MODEL=gpt-4o-mini
# COPILOT_TIMEOUT_MS=45000
# COPILOT_PLANNER=deterministic   # tests only — never use in production
# COPILOT_USE_TEST_PLANNER=1      # local smoke without API keys

# Optional alternate chat providers (OpenAI-compatible APIs)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Workspace Static Memory (stored outside any public web directory)
STATIC_MEMORY_STORAGE_PATH=storage/static-memory
STATIC_MEMORY_MAX_FILE_MB=25
STATIC_MEMORY_WORKSPACE_QUOTA_MB=500

# Comma-separated allowed browser origins.
# Local: include Next/React ports. Prod: public HTTPS only (no :3001 on the domain).
# CORS_ORIGIN=https://opsai.socialchamps.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8080

RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@opsai.local

OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_MINUTES=10
