NODE_ENV=development
PORT=5013

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=opsai

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=12h

OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# Optional alternate chat providers (OpenAI-compatible APIs)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Workspace Static Memory (stored outside any public web directory)
STATIC_MEMORY_STORAGE_PATH=storage/static-memory
STATIC_MEMORY_MAX_FILE_MB=25
STATIC_MEMORY_WORKSPACE_QUOTA_MB=500

# Comma-separated frontend URLs (React + Next.js dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8080

RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@opsai.local

OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_MINUTES=10
